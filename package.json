    "node": ">=20.0.0"
  },
  "keywords": [
    "typescript",
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "otp",
    "social-login",
    "clean-architecture",
    "security"
  ],
  "author": "Rohit Kumar",
  "license": "ISC",
