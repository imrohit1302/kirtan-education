        {
          "name": "Sign Up (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    if (jsonData.data.tokens && jsonData.data.tokens.accessToken) {",
                  "        pm.collectionVariables.set('token', jsonData.data.tokens.accessToken);",
                  "        pm.collectionVariables.set('refreshToken', jsonData.data.tokens.refreshToken);",
                  "    }",
                  "    if (jsonData.data.otp) {",
                  "        pm.collectionVariables.set('otp', jsonData.data.otp);",
                  "    }",
                  "    if (jsonData.data.user && jsonData.data.user._id) {",
                  "        pm.collectionVariables.set('userId', jsonData.data.user._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Inderjeet Singh\",\n  \"email\": \"inderjeet@yopmail.com\",\n  \"password\": \"123456\",\n  \"phone\": \"6283396959\",\n  \"countryCode\": \"+91\",\n  \"isoCode\": \"IN\",\n  \"deviceType\": \"ios\",\n  \"deviceToken\": \"fcm-token-test-123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sign-up",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sign-up"]
            },
            "description": "Registers a new user and generates a 6-digit numeric OTP for account verification."
          }
