# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your local values.
# ==============================================================================

# Server Runtime Configuration
NODE_ENV=development
PORT=9003

# Database Connection (MongoDB)
# Local instance or MongoDB Atlas Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/kirtan_education

# Security & JSON Web Tokens (JWT)
# IMPORTANT: Generate cryptographically secure keys (e.g., node -e "console.log(crypto.randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=c518df9a85012e8477ffec954d2e5b7b6540c4a4e8d356c39a3f2b6e1e123456
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=7f8a9b2c3d4e5f6a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a
JWT_REFRESH_EXPIRATION=7d
JWT_COOKIE_EXPIRES_IN_DAYS=7

# Client & CORS Whitelist (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Logging Level (error, warn, info, http, debug)
LOG_LEVEL=debug
